# Cloudflare Static Assets cache policy for Keywulf.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Rationale:
#  - /assets/* is fingerprinted by Vite (content hash in the filename), so it is
#    immutable and safe to cache forever.
#  - /data/today.json is the daily puzzle. It MUST NOT get stuck on yesterday's
#    challenge, so it is always revalidated. The app also fetches it with a
#    cache-busting query param as a belt-and-suspenders measure.
#  - HTML must revalidate so returning players pick up new deploys immediately.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/data/today.json
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/og/*
  Cache-Control: public, max-age=3600, must-revalidate
