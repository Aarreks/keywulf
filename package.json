{
  "name": "keywulf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Keywulf - a daily typing game built from the world's most important news.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "generate:daily": "tsx scripts/generate-daily.ts",
    "build:sample": "tsx scripts/build-sample.ts",
    "validate:challenge": "tsx scripts/validate-challenge.ts public/data/today.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@google/genai": "^1.9.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^25.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5",
    "wrangler": "^3.78.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  }
}
