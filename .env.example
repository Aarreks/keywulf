# ---------------------------------------------------------------------------
# Keywulf environment variables
# ---------------------------------------------------------------------------
# These are used ONLY by the daily generation script (scripts/generate-daily.ts),
# which runs on GitHub Actions once per day. They are NEVER read by the browser
# app and must NEVER be prefixed with VITE_ (that would inline them into the
# client bundle). See DEPLOY.md for how to verify the key never ships to clients.
#
# For local generation, copy this file to `.env` and fill in your key:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Your Google AI Studio / Gemini API key (server-side only).
GEMINI_API_KEY=

# Which Gemini model to use for daily generation. Override to change models
# without touching code. See DEPLOY.md ("Changing the Gemini model").
# The generator uses Google Search grounding, which requires a model that
# supports the google_search tool.
GEMINI_MODEL=gemini-2.5-flash

# Optional: hard cap on output tokens per generation attempt (safety valve
# against runaway cost on a malformed response). Defaults to 8000.
GEMINI_MAX_OUTPUT_TOKENS=8000

# Optional: override the challenge date (YYYY-MM-DD, UTC) the generator targets.
# Leave blank to use "today" in UTC. Useful for regenerating a specific day.
KEYWULF_DATE=
